{
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.15.1"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run build:dev",
    "build:prod": "pnpm run /^build:prod:.*$/",
    "build:prod:js": "cross-env NODE_ENV=production BUILD_TARGET=js vp build --mode production",
    "build:prod:css": "cross-env NODE_ENV=production BUILD_TARGET=css vp build --mode production",
    "build:prod:server": "tsc -p src/main/resources/tsconfig.json",
    "build:dev": "pnpm run /^build:dev:.*$/",
    "build:dev:js": "cross-env NODE_ENV=development BUILD_TARGET=js vp build --mode development",
    "build:dev:css": "cross-env NODE_ENV=development BUILD_TARGET=css vp build --mode development",
    "build:dev:server": "tsc -p src/main/resources/tsconfig.json --sourceMap",
    "dev": "vp dev",
    "dev:fixtures": "node dev/generate-fixtures.ts",
    "dev:append": "node dev/generate-fixtures.ts --append",
    "check": "vp lint && pnpm run check:types && pnpm run test",
    "check:types": "tsc --noEmit -p src/main/resources/tsconfig.json && tsc --noEmit && tsc --noEmit -p dev/tsconfig.json",
    "test": "vp test --run",
    "fix": "vp fmt && vp lint --fix",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@enonic-types/core": "8.0.3",
    "@enonic-types/global": "8.0.3",
    "@enonic-types/lib-admin": "8.0.3",
    "@enonic-types/lib-auditlog": "8.0.3",
    "@enonic-types/lib-auth": "8.0.3",
    "@enonic-types/lib-context": "8.0.3",
    "@enonic-types/lib-event": "8.0.3",
    "@enonic-types/lib-export": "8.0.3",
    "@enonic-types/lib-i18n": "8.0.3",
    "@enonic-types/lib-io": "8.0.3",
    "@enonic-types/lib-node": "8.0.3",
    "@enonic-types/lib-portal": "8.0.3",
    "@enonic-types/lib-repo": "8.0.3",
    "@enonic-types/lib-task": "8.0.3",
    "@enonic-types/lib-websocket": "8.0.3",
    "@tailwindcss/vite": "~4.3.3",
    "@tanstack/react-query-devtools": "~5.101.2",
    "@tanstack/react-router-devtools": "~1.167.0",
    "@tanstack/router-plugin": "~1.168.23",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "~16.3.2",
    "@testing-library/user-event": "~14.6.1",
    "@types/node": "~26.3.0",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "~6.0.3",
    "cross-env": "~10.1.0",
    "jsdom": "~29.1.1",
    "tailwindcss": "~4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "~1.1.19",
    "@radix-ui/react-checkbox": "~1.3.7",
    "@radix-ui/react-dialog": "~1.1.19",
    "@radix-ui/react-dropdown-menu": "~2.1.20",
    "@radix-ui/react-label": "~2.1.11",
    "@radix-ui/react-progress": "~1.1.12",
    "@radix-ui/react-scroll-area": "~1.2.14",
    "@radix-ui/react-select": "~2.3.3",
    "@radix-ui/react-separator": "~1.1.11",
    "@radix-ui/react-slot": "~1.3.0",
    "@radix-ui/react-tabs": "~1.1.17",
    "@radix-ui/react-tooltip": "~1.2.12",
    "@tanstack/react-query": "~5.101.2",
    "@tanstack/react-router": "~1.170.18",
    "@tanstack/react-table": "~8.21.3",
    "@tanstack/react-virtual": "~3.14.10",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "i18next": "~26.3.6",
    "lucide-react": "~1.25.0",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "react-i18next": "~17.0.10",
    "shiki": "~4.3.1",
    "sonner": "~2.0.7",
    "tailwind-merge": "~3.6.0",
    "zod": "~4.4.3"
  }
}
