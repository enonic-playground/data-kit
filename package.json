{
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.13.1",
    "pnpm": ">=11.1.3"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run build:dev",
    "build:prod": "pnpm run /^build:prod:.*$/",
    "build:prod:js": "cross-env NODE_ENV=production BUILD_TARGET=js vp build --mode production",
    "build:prod:css": "cross-env NODE_ENV=production BUILD_TARGET=css vp build --mode production",
    "build:prod:server": "cross-env NODE_ENV=production node esbuild.server.js",
    "build:dev": "pnpm run /^build:dev:.*$/",
    "build:dev:js": "cross-env NODE_ENV=development BUILD_TARGET=js vp build --mode development",
    "build:dev:css": "cross-env NODE_ENV=development BUILD_TARGET=css vp build --mode development",
    "build:dev:server": "cross-env NODE_ENV=development node esbuild.server.js",
    "check": "vp lint && pnpm run check:types && pnpm run test",
    "check:types": "tsgo --noEmit -p src/main/resources/tsconfig.json && tsgo --noEmit",
    "test": "vp test --run",
    "fix": "vp fmt && vp lint --fix",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@enonic-types/core": "8.0.1",
    "@enonic-types/global": "8.0.1",
    "@enonic-types/lib-admin": "8.0.1",
    "@enonic-types/lib-auditlog": "8.0.1",
    "@enonic-types/lib-auth": "8.0.1",
    "@enonic-types/lib-context": "8.0.1",
    "@enonic-types/lib-event": "8.0.1",
    "@enonic-types/lib-export": "8.0.1",
    "@enonic-types/lib-i18n": "8.0.1",
    "@enonic-types/lib-io": "8.0.1",
    "@enonic-types/lib-node": "8.0.1",
    "@enonic-types/lib-portal": "8.0.1",
    "@enonic-types/lib-repo": "8.0.1",
    "@enonic-types/lib-task": "8.0.1",
    "@enonic-types/lib-websocket": "8.0.1",
    "@tailwindcss/vite": "~4.3.0",
    "@tanstack/react-query-devtools": "~5.100.10",
    "@tanstack/react-router-devtools": "~1.167.0",
    "@tanstack/router-plugin": "~1.168.6",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "~16.3.2",
    "@testing-library/user-event": "~14.6.1",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260519.1",
    "@vitejs/plugin-react": "~6.0.2",
    "cross-env": "~10.1.0",
    "esbuild": "~0.28.0",
    "jsdom": "~29.1.1",
    "tailwindcss": "~4.3.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "~1.1.15",
    "@radix-ui/react-checkbox": "~1.3.3",
    "@radix-ui/react-dialog": "~1.1.15",
    "@radix-ui/react-dropdown-menu": "~2.1.16",
    "@radix-ui/react-label": "~2.1.8",
    "@radix-ui/react-progress": "~1.1.8",
    "@radix-ui/react-scroll-area": "~1.2.10",
    "@radix-ui/react-select": "~2.2.6",
    "@radix-ui/react-separator": "~1.1.8",
    "@radix-ui/react-slot": "~1.2.4",
    "@radix-ui/react-tabs": "~1.1.13",
    "@radix-ui/react-tooltip": "~1.2.8",
    "@tanstack/react-query": "~5.100.10",
    "@tanstack/react-router": "~1.170.4",
    "@tanstack/react-table": "~8.21.3",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "i18next": "~26.2.0",
    "lucide-react": "~1.16.0",
    "react": "~19.2.6",
    "react-dom": "~19.2.6",
    "react-i18next": "~17.0.8",
    "shiki": "~4.0.2",
    "sonner": "~2.0.7",
    "tailwind-merge": "~3.6.0",
    "zod": "~4.4.3"
  }
}
